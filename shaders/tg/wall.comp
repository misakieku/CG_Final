#version 460 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "tg/cell.glsl"

layout(rgba8, binding = 0) writeonly uniform image2D uOutAlbedo;
layout(rgba8, binding = 1) writeonly uniform image2D uOutOrm;
layout(r16f, binding = 2) writeonly uniform image2D uOutHeight;

float remapHistogramScan(float x, float position, float contrast)
{
    float span = clamp((1.0 - contrast) * 0.5, 1e-4, 0.5);
    float e0 = clamp(position - span, 0.0, 1.0);
    float e1 = clamp(position + span, 0.0, 1.0);
    return smoothstep(e0, e1, x);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = imageSize(uOutAlbedo);
    if (coord.x >= texSize.x || coord.y >= texSize.y)
    {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(texSize);

    // Heightmap: remapped stone noise + masked ridged cracks -> ModifyStoneHeight
    float baseNoise = FbmScalar2D(uv, 4, 3) * 0.5 + 0.5;
    float stoneHeight = remapHistogramScan(baseNoise, 0.5, 0.55) * 0.25;

    float crackVal = 0.0;
    float crackMask = 0.0;
    MaskedRidgedMultifractal2D(uv, 5.0, 3.0, 5.0, 2.0, crackVal, crackMask);
    float finalCrack = crackVal * crackMask;

    float height = clamp(ModifyStoneHeight(uv, finalCrack, crackMask, stoneHeight), 0.0, 1.0);

    // Clean light slate linear albedo so direct/multi-bounce GI stays vivid (~whitebox brightness)
    vec3 linearAlbedo = vec3(0.61, 0.62, 0.67);

    // Normal (baked from height), AO, and Roughness derived directly from height
    float hNorm = smoothstep(0.08, 0.85, height);
    float ao = mix(0.42, 1.0, hNorm);
    float roughness = mix(0.92, 0.72, hNorm);

    imageStore(uOutAlbedo, coord, vec4(linearAlbedo, 1.0));
    imageStore(uOutOrm, coord, vec4(ao, roughness, 0.0, 1.0));
    imageStore(uOutHeight, coord, vec4(height, 0.0, 0.0, 1.0));
}
