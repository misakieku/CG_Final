#version 460 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "tg/cell.glsl"

layout(rgba8, binding = 0) writeonly uniform image2D uOutAlbedo;
layout(rgba8, binding = 1) writeonly uniform image2D uOutOrm;
layout(r16f, binding = 2) writeonly uniform image2D uOutHeight;

void evalScatteredPebbles(
    vec2 uv,
    ivec2 gridCount,
    float keepThresh,
    float radMin,
    float radMax,
    out float outMask,
    out float outHeight,
    out float outTone)
{
    vec2 p = uv * vec2(gridCount);
    ivec2 baseCell = ivec2(floor(p));

    outMask = 0.0;
    outHeight = 0.0;
    outTone = 0.5;

    for (int dy = -1; dy <= 1; ++dy)
    {
        for (int dx = -1; dx <= 1; ++dx)
        {
            ivec2 cell = baseCell + ivec2(dx, dy);
            vec4 rnd = Hash24(cell, gridCount);
            if (rnd.z < keepThresh)
            {
                continue;
            }

            vec2 center = vec2(cell) + 0.20 + 0.60 * rnd.xy;
            vec2 delta = p - center;

            float ang = rnd.w * 6.2831853;
            float ca = cos(ang);
            float sa = sin(ang);
            vec2 ld = vec2(ca * delta.x + sa * delta.y, -sa * delta.x + ca * delta.y);
            float aspect = mix(0.68, 1.32, fract(rnd.z * 7.13));
            ld.x *= aspect;
            ld.y /= aspect;

            // Irregular chipped silhouette instead of smooth geometric circles
            float theta = atan(ld.y, ld.x);
            float polyWobble = 1.0 + 0.16 * sin(theta * 3.0 + rnd.x * 6.2831) + 0.10 * cos(theta * 5.0 + rnd.y * 6.2831);
            float dist = length(ld) * polyWobble;

            float radius = mix(radMin, radMax, fract(rnd.w * 11.73));
            float mask = 1.0 - smoothstep(radius * 0.55, radius, dist);
            if (mask > outMask)
            {
                outMask = mask;
                float dome = smoothstep(radius, 0.0, dist);
                outHeight = sqrt(max(dome, 0.0));
                outTone = fract(rnd.z * 19.31 + rnd.w * 3.7);
            }
        }
    }
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = imageSize(uOutAlbedo);
    if (coord.x >= texSize.x || coord.y >= texSize.y)
    {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(texSize);
    vec2 warp = Fbm2D(uv, 6, 2) * 0.032;
    vec2 wuv = fract(uv + warp);

    // Base soft stylized mud earth undulation
    float broadMud = FbmScalar2D(uv, 4, 3) * 0.5 + 0.5;
    float midMud = FbmScalar2D(uv + vec2(0.41, 0.17), 9, 2) * 0.5 + 0.5;
    float baseHeight = 0.28 + 0.18 * (broadMud * 0.65 + midMud * 0.35);

    vec3 darkEarthLin = vec3(0.26, 0.21, 0.16);
    vec3 warmMudLin = vec3(0.36, 0.30, 0.22);
    vec3 mudCol = mix(darkEarthLin, warmMudLin, clamp(0.20 + broadMud * 0.65 + midMud * 0.15, 0.0, 1.0));

    // Painterly olive-sage moss pockets growing across damp earth
    float mossMacro = FbmScalar2D(uv + vec2(0.19, 0.63), 5, 3) * 0.5 + 0.5;
    float mossMicro = FbmScalar2D(wuv, 12, 2) * 0.5 + 0.5;
    float mossMask = smoothstep(0.44, 0.70, mossMacro * 0.65 + mossMicro * 0.35);
    vec3 oliveMossLin = mix(vec3(0.21, 0.29, 0.14), vec3(0.31, 0.40, 0.19), mossMicro);

    // Multi-scale irregular stylized pebble chunks & gravel chips bridging mud toward grey flagstones
    float bigMask = 0.0;
    float bigH = 0.0;
    float bigTone = 0.5;
    evalScatteredPebbles(wuv, ivec2(10, 10), 0.50, 0.32, 0.60, bigMask, bigH, bigTone);

    float smallMask = 0.0;
    float smallH = 0.0;
    float smallTone = 0.5;
    evalScatteredPebbles(fract(wuv + vec2(0.37, 0.71)), ivec2(22, 22), 0.42, 0.28, 0.54, smallMask, smallH, smallTone);

    // Combine small gravel under large pebble chunks
    float pebbleMask = clamp(max(bigMask, smallMask * (1.0 - bigMask * 0.75)), 0.0, 1.0);
    float pebbleH = max(bigH * bigMask, smallH * smallMask * 0.75);
    float pebbleTone = (bigMask >= smallMask * 0.8) ? bigTone : smallTone;

    vec3 warmGravelLin = vec3(0.38, 0.33, 0.26);
    vec3 tanStoneLin = vec3(0.48, 0.43, 0.36);
    vec3 paleSlateLin = vec3(0.54, 0.52, 0.49);
    vec3 pebbleCol = (pebbleTone < 0.45)
        ? mix(warmGravelLin, tanStoneLin, pebbleTone / 0.45)
        : mix(tanStoneLin, paleSlateLin, (pebbleTone - 0.45) / 0.55);

    // Moss settles in pockets around pebbles rather than covering pebble tops
    float effectiveMoss = mossMask * (1.0 - pebbleMask * 0.72);
    vec3 linearAlbedo = mix(mudCol, oliveMossLin, effectiveMoss * 0.85);
    linearAlbedo = mix(linearAlbedo, pebbleCol, pebbleMask);

    float height = clamp(baseHeight + effectiveMoss * 0.06 + pebbleH * 0.52, 0.0, 1.0);
    float ao = clamp(mix(0.62, 0.92, broadMud) + pebbleMask * 0.14 - effectiveMoss * 0.06, 0.48, 1.0);
    float roughness = clamp(mix(0.84, 0.68, pebbleMask) + effectiveMoss * 0.08 - broadMud * 0.06, 0.58, 0.95);

    imageStore(uOutAlbedo, coord, vec4(linearAlbedo, 1.0));
    imageStore(uOutOrm, coord, vec4(ao, roughness, 0.0, 1.0));
    imageStore(uOutHeight, coord, vec4(height, 0.0, 0.0, 1.0));
}
