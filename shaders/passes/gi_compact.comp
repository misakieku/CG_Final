#version 460 core
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "common/frame_ubo.glsl"
#include "common/lighting_common.glsl"
#include "common/tonemap.glsl"
#include "common/gi_common.glsl"

layout(std430, binding = 7) readonly buffer GiProbeMetaBuffer
{
    uint ProbeMeta[];
};

layout(std430, binding = 8) readonly buffer GiActiveFlagBuffer
{
    uint ActiveFlags[];
};

layout(std430, binding = 9) writeonly buffer GiActiveListBuffer
{
    uint ActiveProbeIds[];
};

layout(std430, binding = 10) buffer GiDispatchCmdBuffer
{
    uint TraceGroupsX;
    uint TraceGroupsY;
    uint TraceGroupsZ;
    uint ActiveProbeCount;
    uint BlendGroupsX;
    uint BlendGroupsY;
    uint BlendGroupsZ;
    uint BlendPad;
};

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= uGiDims.w)
    {
        return;
    }
    if (ActiveFlags[id] != 0u && ProbeMeta[id] != 0u)
    {
        uint slot = atomicAdd(ActiveProbeCount, 1u);
        ActiveProbeIds[slot] = id;
        if ((slot % uint(GI_PROBES_PER_GROUP)) == 0u)
        {
            atomicAdd(TraceGroupsX, 1u);
        }
        if ((slot & 63u) == 0u)
        {
            atomicAdd(BlendGroupsX, 1u);
        }
    }
}
