#version 460 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "common/frame_ubo.glsl"
#include "common/fog_common.glsl"

layout(binding = 0) uniform sampler3D uFogRawTex;
layout(rgba16f, binding = 0) writeonly uniform image3D uOutFogAccum;

void main()
{
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    ivec3 dims = ivec3(uFogDims.xyz);
    if (xy.x >= dims.x || xy.y >= dims.y)
    {
        return;
    }

    float nearZ = max(uTimeParams.z, 0.05);
    float fogFar = max(uFogParams.w, nearZ + 1.0);
    float invSlices = 1.0 / float(dims.z);

    vec3 accumLight = vec3(0.0);
    float accumTrans = 1.0;

    for (int z = 0; z < dims.z; ++z)
    {
        float z0 = fogSliceToLinearZ(float(z) * invSlices, nearZ, fogFar);
        float z1 = fogSliceToLinearZ(float(z + 1) * invSlices, nearZ, fogFar);
        float sliceLen = max(z1 - z0, 1e-4);

        vec4 raw = texelFetch(uFogRawTex, ivec3(xy, z), 0);
        vec3 inScatter = max(raw.rgb, vec3(0.0));
        float sigmaT = max(raw.a, 0.0);

        float tr = exp(-sigmaT * sliceLen);
        vec3 stepScatter = (sigmaT > 1e-5) ? (inScatter * ((1.0 - tr) / sigmaT)) : (inScatter * sliceLen);

        accumLight += accumTrans * stepScatter;
        accumTrans *= tr;

        imageStore(uOutFogAccum, ivec3(xy, z), vec4(accumLight, accumTrans));
    }
}
