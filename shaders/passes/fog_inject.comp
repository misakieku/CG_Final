#version 460 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "common/frame_ubo.glsl"
#include "common/lighting_common.glsl"
#include "common/tonemap.glsl"
#include "common/gi_common.glsl"
#include "common/fog_common.glsl"

layout(binding = 0) uniform sampler3D uPrevFogTex;
layout(binding = 1) uniform sampler2DShadow uShadowMap;
layout(binding = 2) uniform sampler3D uGiSh0;
layout(binding = 3) uniform sampler3D uGiSh1;
layout(binding = 4) uniform sampler3D uGiSh2;
layout(binding = 5) uniform usampler2D uMazeGrid;

layout(rgba16f, binding = 0) writeonly uniform image3D uOutFogRaw;

layout(std430, binding = 4) readonly buffer LightsBuffer
{
    GpuPointLight Lights[];
};

layout(std430, binding = 5) readonly buffer ClusterCountsBuffer
{
    uint ClusterCounts[];
};

layout(std430, binding = 6) readonly buffer ClusterIndicesBuffer
{
    uint ClusterLightIndices[];
};

float sampleFogMoonShadow(vec3 worldPos)
{
    if (uShadowParams.z < 0.5)
    {
        return 0.0;
    }
    vec4 sc = uLightViewProj * vec4(worldPos, 1.0);
    sc.xyz /= sc.w;
    vec2 suv = sc.xy * 0.5 + 0.5;
    if (suv.x <= 0.0 || suv.x >= 1.0 || suv.y <= 0.0 || suv.y >= 1.0 || sc.z <= 0.0 || sc.z >= 1.0)
    {
        return 0.0;
    }
    return texture(uShadowMap, vec3(suv, sc.z));
}

void main()
{
    ivec3 gid = ivec3(gl_GlobalInvocationID);
    ivec3 dims = ivec3(uFogDims.xyz);
    if (any(greaterThanEqual(gid, dims)))
    {
        return;
    }

    float baseDensity = uFogParams.x;
    if (baseDensity <= 1e-5)
    {
        imageStore(uOutFogRaw, gid, vec4(0.0));
        return;
    }

    float nearZ = max(uTimeParams.z, 0.05);
    float fogFar = max(uFogParams.w, nearZ + 1.0);
    float g = clamp(uFogParams.y, -0.92, 0.92);
    float heightFalloff = max(uFogParams.z, 0.0);

    // Deterministic R2 sub-voxel temporal jitter breaks shadow and cluster banding over a few frames
    uint seed = uint(gid.x) * 1973u + uint(gid.y) * 9277u + uint(gid.z) * 26699u;
    float h0 = fract(sin(float(seed) * 0.0137) * 43758.5453);
    uint tPhase = uCounts.w & 15u;
    vec3 jitter = fract(vec3(h0, fract(h0 * 1.6180339), fract(h0 * 2.2360679))
                + float(tPhase) * vec3(0.754877666, 0.569840291, 0.430159709)) - 0.5;

    vec2 centerUV = (vec2(gid.xy) + 0.5) / vec2(dims.xy);
    vec2 jitterUV = clamp((vec2(gid.xy) + 0.5 + jitter.xy * 0.85) / vec2(dims.xy), vec2(0.001), vec2(0.999));

    float centerNormZ = (float(gid.z) + 0.5) / float(dims.z);
    float jitterNormZ = clamp((float(gid.z) + 0.5 + jitter.z * 0.85) / float(dims.z), 0.0, 1.0);

    float centerZ = fogSliceToLinearZ(centerNormZ, nearZ, fogFar);
    float sampleZ = fogSliceToLinearZ(jitterNormZ, nearZ, fogFar);

    vec3 centerWorldPos = reconstructFogWorldPos(centerUV, centerZ);
    vec3 worldPos = reconstructFogWorldPos(jitterUV, sampleZ);

    // Height-exponential density keeps dungeon corridors misty while leaving the high night sky crisp
    float sigmaT = baseDensity * exp(-max(worldPos.y - 0.5, 0.0) * heightFalloff);

    bool insideWall = false;
    if (uGiDims.w > 0u && worldPos.y <= uGiMisc.x)
    {
        ivec2 maxGrid = ivec2(int(uGiMisc.y) - 1, int(uGiMisc.z) - 1);
        ivec2 cell = clamp(ivec2(floor(worldPos.xz / uGiGridInvStep.w)), ivec2(0), maxGrid);
        insideWall = (texelFetch(uMazeGrid, cell, 0).r == kGiCellWall);
    }

    vec3 scatterLight = vec3(0.0);
    if (!insideWall && sigmaT > 1e-6)
    {
        vec3 rayDir = normalize(worldPos - uCameraPos.xyz);

        float moonShadow = sampleFogMoonShadow(worldPos);
        float moonPhase = evalHgPhase(dot(rayDir, kMoonDir), g);
        scatterLight += kMoonColor * (0.78 * moonShadow * moonPhase);

        uint clusterId = computeClusterId(jitterUV, worldPos);
        uint maxPerCluster = uClusterDims.w;
        uint count = min(ClusterCounts[clusterId], 32u);
        uint baseOffset = clusterId * maxPerCluster;
        float time = uTimeParams.x;

        for (uint k = 0u; k < count; ++k)
        {
            uint lightIdx = ClusterLightIndices[baseOffset + k];
            GpuPointLight light = Lights[lightIdx];
            vec3 toLight = light.positionRadius.xyz - worldPos;
            float d2 = dot(toLight, toLight);
            float radius = light.positionRadius.w;
            if (d2 >= radius * radius || d2 <= 1e-4)
            {
                continue;
            }
            float wallVis = (uGiDims.w > 0u) ? evalPointLightWallVisibility(worldPos, light.positionRadius.xyz, uMazeGrid) : 1.0;
            if (wallVis <= 1e-3)
            {
                continue;
            }
            float d = sqrt(d2);
            vec3 L = toLight / d;
            float phase = evalHgPhase(dot(rayDir, L), g);
            float atten = computePointLightAttenuation(d2, radius);
            float flicker = computeFlameFlicker(time, lightIdx);
            scatterLight += light.colorIntensity.rgb * (light.colorIntensity.w * atten * flicker * wallVis * phase);
        }

        // Reuse the 3D GI probe field for indirect colored ambient mist in corridors
        vec3 giAmbient = vec3(0.018, 0.024, 0.038);
        if (uGiDims.w > 0u)
        {
            vec3 gridCoord = (worldPos - uGiGridOrigin.xyz) * uGiGridInvStep.xyz;
            vec3 giUVW = clamp((gridCoord + 0.5) / vec3(uGiDims.xyz), vec3(0.0), vec3(1.0));
            vec3 sh0Rgb = vec3(texture(uGiSh0, giUVW).x, texture(uGiSh1, giUVW).x, texture(uGiSh2, giUVW).x);
            giAmbient = max(sh0Rgb, vec3(0.0)) * 0.45 + vec3(0.008, 0.011, 0.018);
        }
        scatterLight += giAmbient * 0.25;
    }

    vec4 current = vec4(scatterLight * sigmaT, sigmaT);

    // Temporal reprojection using un-jittered centerWorldPos
    if (uCounts.w > 0u)
    {
        vec4 prevClip = uPrevViewProj * vec4(centerWorldPos, 1.0);
        if (prevClip.w > nearZ && prevClip.w < fogFar)
        {
            vec2 prevUV = (prevClip.xy / prevClip.w) * 0.5 + 0.5;
            if (all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0))))
            {
                float prevS = log(clamp(prevClip.w, nearZ, fogFar) / nearZ) / log(fogFar / nearZ);
                vec3 prevUVW = vec3(prevUV, clamp(prevS, 0.5 / float(dims.z), 1.0 - 0.5 / float(dims.z)));
                vec4 history = max(texture(uPrevFogTex, prevUVW), vec4(0.0));
                current = mix(history, current, 0.22);
            }
        }
    }

    imageStore(uOutFogRaw, gid, current);
}
